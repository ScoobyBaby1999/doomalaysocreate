# Copy to `.env` for LOCAL dev only. On Hugging Face these go in
# Space -> Settings -> Secrets (NEVER commit a real .env - it is gitignored).
#
# Only the providers used by your panel.json are strictly required. The default
# panel is three frontier models, each on its own native channel:
#   ZAI_API_KEY        -> GLM 5.1          (https://z.ai)
#   NVIDIA_API_KEY     -> DeepSeek V4 Pro  (https://build.nvidia.com)
#   MOONSHOT_API_KEY   -> Kimi K2.6        (https://platform.moonshot.ai)
# Optional extra judges:
#   GOOGLE_API_KEY     -> Gemini           (https://aistudio.google.com/apikey)
#   OPENROUTER_API_KEY -> free fallbacks   (https://openrouter.ai/keys)
#   CEREBRAS_API_KEY   -> kept but unused  (https://cloud.cerebras.ai)

# --- bearer token guarding the API (REQUIRED) ------------------------------
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRITIQUE_TOKEN=

# --- provider API keys ------------------------------------------------------
ZAI_API_KEY=
NVIDIA_API_KEY=
MOONSHOT_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# --- optional tuning --------------------------------------------------------
# PORT=7860
# CRITIQUE_MAX_TOKENS=1500
# JUDGE_TIMEOUT_S=180
# LOOM_LOG=1
