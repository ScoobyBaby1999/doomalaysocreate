# Copy to `.env` for LOCAL dev only. On Hugging Face these go in
# Space -> Settings -> Secrets (NEVER commit a real .env - it is gitignored).
#
# Only the providers used by your panel.json are strictly required. The default
# panel uses one judge per provider, each on its own free channel:
#   ZAI_API_KEY        -> GLM 5.1            (https://z.ai)
#   NVIDIA_API_KEY     -> Nemotron Ultra 253B (https://build.nvidia.com)
#   OPENROUTER_API_KEY -> DeepSeek-R1 (free) (https://openrouter.ai/keys)
#   CEREBRAS_API_KEY   -> Qwen-3-235B        (https://cloud.cerebras.ai)

# --- bearer token guarding POST /api/critique (REQUIRED) -------------------
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRITIQUE_TOKEN=

# --- provider API keys ------------------------------------------------------
ZAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# --- optional tuning --------------------------------------------------------
# PORT=7860
# CRITIQUE_MAX_TOKENS=1500
# JUDGE_TIMEOUT_S=180
# LOOM_LOG=1
