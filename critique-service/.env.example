# Copy to `.env` for LOCAL dev only. On Hugging Face these go in
# Space -> Settings -> Secrets (NEVER commit a real .env - it is gitignored).
#
# Providers are defined in providers_catalog.json; a provider joins rotation when
# its key (below) is present. Set as many CORE keys as you like - the gateway
# rotates + fails over across whatever is configured.

# --- bearer token guarding the API (REQUIRED) ------------------------------
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRITIQUE_TOKEN=

# --- OR auto-rotating tokens (recommended for shared/exposed use) -----------
# Set a long-lived ROOT secret that NEVER travels on the wire; clients derive the
# current bearer token from it (python tools/gen_token.py). The wire token rotates
# every TOKEN_WINDOW_S and a leaked one self-expires. Leave CRITIQUE_TOKEN unset to
# require rotation. generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRITIQUE_ROTATION_SECRET=
# TOKEN_WINDOW_S=3600        # rotation period (default 1h)

# --- CORE pool (recurring-free; always rotated when set) --------------------
NVIDIA_API_KEY=          # https://build.nvidia.com
GOOGLE_API_KEY=          # or GEMINI_API_KEY   (https://aistudio.google.com/apikey)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
GROQ_API_KEY=            # https://console.groq.com/keys
CF_API_TOKEN=            # Cloudflare Workers AI - REQUIRES CF_ACCOUNT_ID too
CF_ACCOUNT_ID=
GITHUB_TOKEN=            # GitHub Models marketplace (or GH_TOKEN)

# --- OPT-IN pool (trial/native/paid; xAI Grok excluded entirely) -----------
# only registered when listed in OPTIN_PROVIDERS *and* their key is set.
ZAI_API_KEY=             # native GLM (https://z.ai)
MOONSHOT_API_KEY=        # native Kimi (https://platform.moonshot.ai)
# FIREWORKS_API_KEY=
# SAMBANOVA_API_KEY=
# OPTIN_PROVIDERS=zai,moonshot

# --- metrics persistence (optional but recommended) ------------------------
# Per-profile metrics survive the ephemeral Space FS by mirroring to a PRIVATE
# HF Dataset. Without these the store runs in-memory only (still queryable).
# METRICS_HF_REPO=your-username/loom-metrics
# HF_TOKEN=
# METRICS_SAMPLE_OUTPUTS=0   # 1 = also retain a 500-char output sample per call

# --- research mode (web search + deep reasoning) ---------------------------
# POST with "research": true to give a model an agentic web loop (search + fetch)
# + a big token budget; "reasoning": true for deep thinking without the web.
# Search uses Tavily when this key is set, else keyless DuckDuckGo (less reliable).
# NOTE: the Space's network access must permit outbound to the web for tools to work.
# TAVILY_API_KEY=
# RESEARCH_MAX_STEPS=8       # max tool calls per research answer
# RESEARCH_MAX_TOKENS=32768  # per-judge token floor when reasoning/research is on
# WEB_FETCH_MAX_CHARS=24000

# --- optional tuning --------------------------------------------------------
# PORT=7860
# CRITIQUE_MAX_TOKENS=16384
# JUDGE_TIMEOUT_S=1800
# DEFAULT_EFFORT=med         # low|med|high|max
# STREAM=1                   # 0 = disable response streaming
# JUDGE_RETRIES=0            # same-slot retries ON TOP of cross-provider failover
# MOCK_MODE=0                # 1 = synthetic provider, zero real API calls (testing)
# LOOM_LOG=1
